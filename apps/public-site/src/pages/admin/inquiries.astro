---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout
  title="問い合わせ管理"
  description="問い合わせ件数と内容を確認しやすい形に整理しています。"
  currentSection="inquiries"
>
  <section class="admin-section">
    <div class="admin-section__panel">
      <form id="admin-inquiry-search-form" class="admin-inquiry-search">
        <div class="admin-inquiry-search__field">
          <label for="admin-inquiry-search-input">問い合わせを検索</label>
          <input
            id="admin-inquiry-search-input"
            name="q"
            type="search"
            placeholder="お名前、メール、電話番号、本文、物件番号など"
            autocomplete="off"
          />
        </div>

        <div class="admin-inquiry-search__actions">
          <button type="submit" class="admin-inquiry-search__submit">
            検索する
          </button>
          <button
            type="button"
            class="admin-inquiry-search__clear"
            data-clear-inquiry-search
          >
            条件をクリア
          </button>
        </div>
      </form>

      <p class="admin-inquiry-search__help">
        お名前、メールアドレス、電話番号、問い合わせ本文、物件タイトル、
        物件番号、slugを横断検索します。
      </p>

      <div id="admin-inquiries-root">
        <p class="admin-loading">問い合わせ一覧を読み込み中...</p>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  import {
    fetchDetail,
    escapeHtml,
    formatDateTime,
  } from "../../lib/admin/client";
  import type { AdminInquiryListItem } from "../../types/admin";

  type InquiryListResponse = {
    items?: AdminInquiryListItem[];
    total?: number;
    page?: number;
    pageSize?: number;
  };

  type InquiryListState = {
    q: string;
    page: number;
  };

  const DEFAULT_PAGE_SIZE = 20;

  const root = document.getElementById("admin-inquiries-root");
  const searchForm = document.getElementById("admin-inquiry-search-form");
  const searchInput = document.getElementById("admin-inquiry-search-input");
  const clearSearchButton = document.querySelector("[data-clear-inquiry-search]");

  const normalizeListResponse = (
    response: InquiryListResponse | AdminInquiryListItem[],
  ) => {
    if (Array.isArray(response)) {
      return {
        items: response,
        total: response.length,
        page: 1,
        pageSize: DEFAULT_PAGE_SIZE,
      };
    }

    const items = Array.isArray(response?.items) ? response.items : [];
    const total = Math.max(0, Number(response?.total ?? items.length) || 0);
    const page = Math.max(1, Number(response?.page ?? 1) || 1);
    const pageSize = Math.max(
      1,
      Number(response?.pageSize ?? DEFAULT_PAGE_SIZE) || DEFAULT_PAGE_SIZE,
    );

    return {
      items,
      total,
      page,
      pageSize,
    };
  };

  const getStateFromLocation = (): InquiryListState => {
    const params = new URLSearchParams(window.location.search);
    const q = (params.get("q") ?? "").trim();
    const rawPage = Number(params.get("page") ?? "1");

    return {
      q,
      page: Number.isFinite(rawPage) && rawPage >= 1
        ? Math.floor(rawPage)
        : 1,
    };
  };

  const writeStateToLocation = (
    state: InquiryListState,
    replace = false,
  ) => {
    const url = new URL(window.location.href);

    if (state.q) {
      url.searchParams.set("q", state.q);
    } else {
      url.searchParams.delete("q");
    }

    if (state.page > 1) {
      url.searchParams.set("page", String(state.page));
    } else {
      url.searchParams.delete("page");
    }

    url.searchParams.delete("pageSize");

    const nextUrl = `${url.pathname}${url.search}${url.hash}`;

    if (replace) {
      window.history.replaceState({}, "", nextUrl);
    } else {
      window.history.pushState({}, "", nextUrl);
    }
  };

  const syncFormWithState = (state: InquiryListState) => {
    if (searchInput instanceof HTMLInputElement) {
      searchInput.value = state.q;
    }
  };

  const buildInquiryApiPath = (state: InquiryListState) => {
    const params = new URLSearchParams();

    if (state.q) {
      params.set("q", state.q);
    }

    params.set("page", String(state.page));
    params.set("pageSize", String(DEFAULT_PAGE_SIZE));

    return `/api/admin/inquiries?${params.toString()}`;
  };

  const getInquiryName = (item: AdminInquiryListItem) =>
    item.name ?? "-";

  const getInquiryEmail = (item: AdminInquiryListItem) =>
    item.email ?? "-";

  const getInquiryPhone = (item: AdminInquiryListItem) =>
    item.phone ?? "-";

  const getInquiryProperty = (item: AdminInquiryListItem) => {
    const title = item.propertyTitle ?? null;
    const propertyNumber = item.propertyNumber ?? null;
    const slug = item.propertySlug ?? null;

    if (title && propertyNumber) {
      return `${title}（物件番号: ${propertyNumber}）`;
    }

    if (title) {
      return title;
    }

    if (propertyNumber) {
      return `物件番号: ${propertyNumber}`;
    }

    return slug ?? "-";
  };

  const getInquiryPropertyUrl = (item: AdminInquiryListItem) => {
    const slug = String(item.propertySlug ?? "").trim();

    if (!slug) {
      return null;
    }

    return `/properties/${encodeURIComponent(slug)}`;
  };

  const renderInquiryProperty = (item: AdminInquiryListItem) => {
    const propertyText = getInquiryProperty(item);
    const propertyUrl = getInquiryPropertyUrl(item);

    if (propertyText === "-") {
      return "物件: -";
    }

    if (!propertyUrl) {
      return `物件: ${escapeHtml(propertyText)}`;
    }

    return `物件: <a href="${escapeHtml(propertyUrl)}" class="admin-inquiry-property-link" target="_blank" rel="noreferrer">${escapeHtml(propertyText)}</a>`;
  };

  const getInquiryCreatedAt = (item: AdminInquiryListItem) =>
    item.createdAt ?? null;

  const getInquiryMessage = (item: AdminInquiryListItem) =>
    item.message ?? "";

  const renderError = (message: string) => {
    if (!root) return;
    root.innerHTML = `<p class="admin-error">${escapeHtml(message)}</p>`;
  };

  const deleteInquiry = async (id: string) => {
    const response = await fetch(
      `/api/admin/inquiries/${encodeURIComponent(id)}`,
      {
        method: "DELETE",
        headers: {
          Accept: "application/json",
        },
      },
    );

    let data: { message?: string } | null = null;

    try {
      data = await response.json();
    } catch {
      data = null;
    }

    if (!response.ok) {
      throw new Error(data?.message ?? "問い合わせの削除に失敗しました。");
    }

    return data;
  };

  const renderPagination = ({
    total,
    page,
    pageSize,
  }: {
    total: number;
    page: number;
    pageSize: number;
  }) => {
    if (total === 0) {
      return "";
    }

    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    const start = (page - 1) * pageSize + 1;
    const end = Math.min(page * pageSize, total);

    return `
      <div class="admin-inquiry-pagination">
        <button
          type="button"
          class="admin-inquiry-pagination__button"
          data-inquiry-page="${page - 1}"
          ${page <= 1 ? "disabled" : ""}
        >
          前へ
        </button>

        <div class="admin-inquiry-pagination__status">
          <strong>${escapeHtml(page)} / ${escapeHtml(totalPages)}ページ</strong>
          <span>${escapeHtml(start)}〜${escapeHtml(end)}件を表示 / 全${escapeHtml(total)}件</span>
        </div>

        <button
          type="button"
          class="admin-inquiry-pagination__button"
          data-inquiry-page="${page + 1}"
          ${page >= totalPages ? "disabled" : ""}
        >
          次へ
        </button>
      </div>
    `;
  };

  const render = (
    response: InquiryListResponse | AdminInquiryListItem[],
    state: InquiryListState,
  ) => {
    if (!root) return;

    const {
      items,
      total,
      page,
      pageSize,
    } = normalizeListResponse(response);

    const withPropertyCount = items.filter(
      (item) => getInquiryProperty(item) !== "-",
    ).length;

    const withMessageCount = items.filter(
      (item) => String(getInquiryMessage(item)).trim() !== "",
    ).length;

    const searchCondition = state.q
      ? `<p class="admin-inquiry-search-result">検索条件: 「${escapeHtml(state.q)}」</p>`
      : "";

    root.innerHTML = `
      ${searchCondition}

      <div class="admin-summary-grid">
        <div class="admin-summary-card">
          <p class="admin-summary-card__label">該当問い合わせ件数</p>
          <p class="admin-summary-card__value">${escapeHtml(total)}</p>
          <p class="admin-summary-card__note">現在の検索条件に一致する総件数です。</p>
        </div>

        <div class="admin-summary-card">
          <p class="admin-summary-card__label">このページの物件紐づき</p>
          <p class="admin-summary-card__value">${escapeHtml(withPropertyCount)}</p>
          <p class="admin-summary-card__note">現在表示中の問い合わせ内の件数です。</p>
        </div>

        <div class="admin-summary-card">
          <p class="admin-summary-card__label">このページの本文あり</p>
          <p class="admin-summary-card__value">${escapeHtml(withMessageCount)}</p>
          <p class="admin-summary-card__note">現在表示中の問い合わせ内の件数です。</p>
        </div>
      </div>

      <div class="admin-section__panel" style="margin-top: 20px;">
        <div class="admin-list-header">
          <div>
            <h2 class="admin-list-header__title">問い合わせ一覧</h2>
            <p class="admin-list-header__meta">
              新しい問い合わせから順に表示しています。
            </p>
          </div>
        </div>

        ${
          items.length
            ? `
              <div class="admin-inquiry-list">
                ${items
                  .map(
                    (item) => `
                      <article class="admin-inquiry-card">
                        <div class="admin-inquiry-card__header">
                          <div>
                            <h3 class="admin-inquiry-card__name">${escapeHtml(getInquiryName(item))}</h3>
                            <p class="admin-inline-text-muted">
                              受付日時: ${escapeHtml(formatDateTime(getInquiryCreatedAt(item)))}
                            </p>
                          </div>

                          <div class="admin-badge-row">
                            <span class="admin-badge admin-badge--neutral">
                              ${renderInquiryProperty(item)}
                            </span>
                          </div>
                        </div>

                        <div class="admin-inquiry-card__meta">
                          <div>
                            <strong>メール</strong>
                            ${escapeHtml(getInquiryEmail(item))}
                          </div>
                          <div>
                            <strong>電話</strong>
                            ${escapeHtml(getInquiryPhone(item))}
                          </div>
                        </div>

                        <div class="admin-inquiry-card__message">
                          <p class="admin-inquiry-card__message-label">本文</p>
                          <p class="admin-inquiry-card__message-text">${escapeHtml(getInquiryMessage(item) || "本文は登録されていません。")}</p>
                        </div>

                        <div class="admin-inquiry-card__actions">
                          <button
                            type="button"
                            class="admin-danger-button"
                            data-delete-inquiry-id="${escapeHtml(item.id ?? "")}"
                            data-delete-inquiry-name="${escapeHtml(getInquiryName(item))}"
                          >
                            削除する
                          </button>
                        </div>
                      </article>
                    `,
                  )
                  .join("")}
              </div>

              ${renderPagination({
                total,
                page,
                pageSize,
              })}
            `
            : `
              <div class="admin-empty-state">
                <p class="admin-empty-state__title">
                  ${
                    state.q
                      ? "検索条件に一致する問い合わせはありません"
                      : "問い合わせはまだありません"
                  }
                </p>
                <p class="admin-empty-state__text">
                  ${
                    state.q
                      ? "検索語を変更するか、検索条件をクリアしてください。"
                      : "公開サイトから送信されると、ここに一覧表示されます。"
                  }
                </p>
              </div>
            `
        }
      </div>
    `;
  };

  const load = async () => {
    if (!root) return;

    const state = getStateFromLocation();
    syncFormWithState(state);

    root.innerHTML = `<p class="admin-loading">問い合わせ一覧を読み込み中...</p>`;

    try {
      const response = await fetchDetail<
        InquiryListResponse | AdminInquiryListItem[]
      >(buildInquiryApiPath(state));

      const normalized = normalizeListResponse(response);
      const totalPages = Math.max(
        1,
        Math.ceil(normalized.total / normalized.pageSize),
      );

      if (normalized.total === 0 && state.page !== 1) {
        writeStateToLocation(
          {
            ...state,
            page: 1,
          },
          true,
        );

        await load();
        return;
      }

      if (normalized.total > 0 && state.page > totalPages) {
        writeStateToLocation(
          {
            ...state,
            page: totalPages,
          },
          true,
        );

        await load();
        return;
      }

      render(response, state);
    } catch (error) {
      renderError(
        error instanceof Error
          ? error.message
          : "問い合わせ一覧の取得に失敗しました。",
      );
    }
  };

  searchForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    const q = searchInput instanceof HTMLInputElement
      ? searchInput.value.trim()
      : "";

    writeStateToLocation({
      q,
      page: 1,
    });

    void load();
  });

  clearSearchButton?.addEventListener("click", () => {
    writeStateToLocation({
      q: "",
      page: 1,
    });

    void load();
  });

  root?.addEventListener("click", async (event) => {
    const target = event.target;

    if (!(target instanceof HTMLElement)) {
      return;
    }

    const pageButton = target.closest("[data-inquiry-page]");

    if (pageButton instanceof HTMLButtonElement) {
      const nextPage = Number(pageButton.dataset.inquiryPage);

      if (
        !pageButton.disabled &&
        Number.isFinite(nextPage) &&
        nextPage >= 1
      ) {
        const state = getStateFromLocation();

        writeStateToLocation({
          ...state,
          page: Math.floor(nextPage),
        });

        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });

        void load();
      }

      return;
    }

    const button = target.closest("[data-delete-inquiry-id]");

    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    const id = button.dataset.deleteInquiryId;
    const name = button.dataset.deleteInquiryName ?? "対象の問い合わせ";

    if (!id) {
      window.alert("問い合わせIDを取得できませんでした。");
      return;
    }

    const confirmed = window.confirm(
      `問い合わせ「${name}」を削除します。\nこの操作は取り消せません。よろしいですか？`,
    );

    if (!confirmed) {
      return;
    }

    const originalLabel = button.textContent ?? "削除する";
    button.disabled = true;
    button.textContent = "削除中...";

    try {
      await deleteInquiry(id);
      window.alert("問い合わせを削除しました。");
      await load();
    } catch (error) {
      window.alert(
        error instanceof Error
          ? error.message
          : "問い合わせの削除に失敗しました。",
      );

      button.disabled = false;
      button.textContent = originalLabel;
    }
  });

  window.addEventListener("popstate", () => {
    void load();
  });

  void load();
</script>
<style>
  :global(.admin-inquiry-search) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 16px;
  }

  :global(.admin-inquiry-search__field) {
    display: grid;
    gap: 8px;
  }

  :global(.admin-inquiry-search__field label) {
    color: #374151;
    font-size: 14px;
    font-weight: 800;
  }

  :global(.admin-inquiry-search__field input) {
    width: 100%;
    min-height: 46px;
    padding: 10px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    background: #ffffff;
    color: #111827;
    font: inherit;
  }

  :global(.admin-inquiry-search__field input:focus) {
    border-color: #2563eb;
    outline: 3px solid rgba(37, 99, 235, 0.14);
  }

  :global(.admin-inquiry-search__actions) {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  :global(.admin-inquiry-search__submit),
  :global(.admin-inquiry-search__clear) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 18px;
    border-radius: 12px;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  :global(.admin-inquiry-search__submit) {
    border: 1px solid #1d4ed8;
    background: #2563eb;
    color: #ffffff;
  }

  :global(.admin-inquiry-search__submit:hover) {
    background: #1d4ed8;
  }

  :global(.admin-inquiry-search__clear) {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #374151;
  }

  :global(.admin-inquiry-search__clear:hover) {
    background: #f8fafc;
  }

  :global(.admin-inquiry-search__help) {
    margin: 10px 0 20px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.7;
  }

  :global(.admin-inquiry-search-result) {
    margin: 0 0 16px;
    padding: 10px 14px;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    background: #eff6ff;
    color: #1e3a8a;
    font-size: 14px;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  :global(.admin-inquiry-pagination) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  :global(.admin-inquiry-pagination__button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 88px;
    min-height: 44px;
    padding: 8px 16px;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    background: #ffffff;
    color: #111827;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  :global(.admin-inquiry-pagination__button:hover:not(:disabled)) {
    background: #f8fafc;
    border-color: #94a3b8;
  }

  :global(.admin-inquiry-pagination__button:disabled) {
    background: #f8fafc;
    color: #94a3b8;
    cursor: not-allowed;
  }

  :global(.admin-inquiry-pagination__status) {
    display: grid;
    gap: 3px;
    min-width: 180px;
    text-align: center;
  }

  :global(.admin-inquiry-pagination__status strong) {
    color: #111827;
    font-size: 14px;
  }

  :global(.admin-inquiry-pagination__status span) {
    color: #64748b;
    font-size: 12px;
  }

  :global(.admin-inquiry-list) {
    display: grid;
    gap: 20px;
    margin-top: 18px;
  }

  :global(.admin-inquiry-card) {
    min-width: 0;
    border: 1px solid #d8dee8;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }

  :global(.admin-inquiry-card__header) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 20px;
    background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
    border-bottom: 1px solid #eef2f7;
  }

  :global(.admin-inquiry-card__name) {
    margin: 0;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 800;
    color: #111827;
  }

  :global(.admin-inquiry-card__header .admin-inline-text-muted) {
    margin-top: 6px;
  }

  :global(.admin-inquiry-card .admin-badge-row) {
    justify-content: flex-end;
    min-width: 0;
    max-width: min(100%, 640px);
  }

  :global(.admin-inquiry-card .admin-badge) {
    max-width: 100%;
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    line-height: 1.6;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  :global(.admin-inquiry-property-link) {
    color: #1d4ed8;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  :global(.admin-inquiry-property-link:hover) {
    color: #1e40af;
  }

  :global(.admin-inquiry-card__meta) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 16px 20px;
    color: #374151;
    font-size: 14px;
    border-bottom: 1px solid #eef2f7;
  }

  :global(.admin-inquiry-card__actions) {
    display: flex;
    justify-content: flex-end;
    padding: 0 20px 18px;
  }

  :global(.admin-danger-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 8px 14px;
    border: 1px solid #fecaca;
    border-radius: 999px;
    background: #fff1f2;
    color: #b91c1c;
    font-weight: 800;
    cursor: pointer;
  }

  :global(.admin-danger-button:hover) {
    background: #ffe4e6;
  }

  :global(.admin-danger-button:disabled) {
    cursor: wait;
    opacity: 0.7;
  }

  :global(.admin-inquiry-card__meta div) {
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: #f8fafc;
    overflow-wrap: anywhere;
  }

  :global(.admin-inquiry-card__meta strong) {
    display: block;
    margin-bottom: 4px;
    color: #6b7280;
    font-size: 12px;
    font-weight: 800;
  }

  :global(.admin-inquiry-card__message) {
    margin: 0;
    padding: 18px 20px 20px;
  }

  :global(.admin-inquiry-card__message-label) {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 800;
    color: #6b7280;
  }

  :global(.admin-inquiry-card__message-text) {
    display: block;
    min-height: 96px;
    margin: 0;
    padding: 14px 16px;
    border: 1px solid #d8dee8;
    border-radius: 12px;
    background: #f4f7fb;
    color: #111827;
    line-height: 1.8;
    text-align: left;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @media (max-width: 720px) {
    :global(.admin-inquiry-search) {
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    :global(.admin-inquiry-search__actions) {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    :global(.admin-inquiry-pagination) {
      gap: 12px;
    }

