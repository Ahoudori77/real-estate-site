---
import type { PropertyDetail } from "../../types/property";
import {
  formatArea,
  formatJapaneseDate,
  formatPercent,
  formatPropertyPrice,
  formatPropertyTypeLabel,
  formatText,
  formatTransactionTypeLabel,
} from "../../lib/utils/format";

interface Props {
  property: PropertyDetail;
}

const { property } = Astro.props;

type SpecRow =
  | {
      type: "section";
      label: string;
    }
  | {
      type: "item";
      label: string;
      value: string;
    };

type PropertyLocationShape = {
  prefecture?: string;
  city?: string;
  address1?: string;
  address2?: string;
  nearestStation?: string;
  accessNote?: string;
};

const location: PropertyLocationShape =
  (property as { location?: PropertyLocationShape }).location ?? {};

const accessText = [location.nearestStation, location.accessNote]
  .filter(Boolean)
  .join(" / ");

const addressText =
  [
    location.prefecture,
    location.city,
    location.address1,
    location.address2,
  ]
    .filter(Boolean)
    .join("") || "-";

const buildingYear =
  property.type === "house"
    ? property.builtYear ?? property.buildingYear
    : null;

const buildingMonth =
  property.type === "house"
    ? property.builtMonth ?? property.buildingMonth
    : null;

const builtText = buildingYear
  ? buildingMonth
    ? `${buildingYear}年${buildingMonth}月`
    : `${buildingYear}年`
  : "-";

const formatParking = (value?: string | boolean | null) => {
  if (typeof value === "boolean") {
    return value ? "あり" : "なし";
  }

  return formatText(value);
};

const landUseZoneText =
  property.zoningDistrict ?? property.landUseZone ?? null;

const rows: SpecRow[] = [
  {
    type: "section",
    label: "基本情報",
  },
  {
    type: "item",
    label: "物件番号",
    value: formatText(property.propertyNumber),
  },
  {
    type: "item",
    label: "物件種別",
    value: formatPropertyTypeLabel(property.type),
  },
  {
    type: "item",
    label: "取引種別",
    value: formatTransactionTypeLabel(property.transactionType),
  },
  {
    type: "item",
    label: "価格",
    value: formatPropertyPrice(property.price, property.priceType),
  },
  {
    type: "item",
    label: "所在地",
    value: addressText,
  },
  {
    type: "item",
    label: "アクセス情報",
    value: accessText || "-",
  },
  {
    type: "section",
    label: "土地情報",
  },
  {
    type: "item",
    label: "土地面積",
    value: formatArea(property.landAreaSqm),
  },
  {
    type: "item",
    label: "地目",
    value: formatText(property.landCategory),
  },
  {
    type: "item",
    label: "都市計画",
    value: formatText(property.cityPlanningArea),
  },
  {
    type: "item",
    label: "用途地域",
    value: formatText(landUseZoneText),
  },
  {
    type: "item",
    label: "建ぺい率",
    value: formatPercent(property.buildingCoverageRatio),
  },
  {
    type: "item",
    label: "容積率",
    value: formatPercent(property.floorAreaRatio),
  },
  {
    type: "item",
    label: "接道",
    value: formatText(property.roadAccess),
  },
  ...(property.type === "house"
    ? [
        {
          type: "section" as const,
          label: "建物情報",
        },
        {
          type: "item" as const,
          label: "建物面積",
          value: formatArea(property.buildingAreaSqm),
        },
        {
          type: "item" as const,
          label: "間取り",
          value: formatText(property.floorPlan),
        },
        {
          type: "item" as const,
          label: "築年月",
          value: builtText,
        },
        {
          type: "item" as const,
          label: "構造",
          value: formatText(property.buildingStructure ?? property.structure),
        },
        {
          type: "item" as const,
          label: "階数",
          value: formatText(property.buildingFloors),
        },
        {
          type: "item" as const,
          label: "駐車場",
          value: formatParking(property.parking),
        },
      ]
    : []),
  {
    type: "section",
    label: "その他",
  },
  {
    type: "item",
    label: "現況",
    value: formatText(property.currentStatus),
  },
  {
    type: "item",
    label: "引渡時期",
    value: formatText(property.handoverTiming),
  },
  {
    type: "item",
    label: "設備",
    value: formatText(property.facilities),
  },
  {
    type: "item",
    label: "備考",
    value: formatText(property.remarks),
  },
  {
    type: "item",
    label: "更新日",
    value: property.updatedAt ? formatJapaneseDate(property.updatedAt) : "-",
  },
];
---

<section class="specs">
  <div class="section-header">
    <h2>物件概要</h2>
    <p>公開情報をもとに、物件の基本情報を掲載しています。</p>
  </div>

  <div class="table-wrap">
    <table>
      <tbody>
        {rows.map((row) =>
          row.type === "section" ? (
            <tr class="section-row">
              <th colspan="2">{row.label}</th>
            </tr>
          ) : (
            <tr>
              <th>{row.label}</th>
              <td>{row.value}</td>
            </tr>
          )
        )}
      </tbody>
    </table>
  </div>
</section>

<style>
  .specs {
    display: grid;
    gap: 16px;
  }

  .section-header h2 {
    margin: 0 0 8px;
    font-size: 28px;
    color: #111827;
  }

  .section-header p {
    margin: 0;
    color: #4b5563;
    line-height: 1.8;
  }

  .table-wrap {
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    background: #fff;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 16px 18px;
    border-bottom: 1px solid #e5e7eb;
    text-align: left;
    vertical-align: top;
  }

  tr:last-child th,
  tr:last-child td {
    border-bottom: none;
  }

  th {
    width: 180px;
    background: #f9fafb;
    color: #374151;
    font-weight: 700;
  }

  td {
    color: #111827;
    line-height: 1.8;
    white-space: pre-wrap;
  }

  .section-row th {
    width: auto;
    background: var(--color-accent-pale);
    color: var(--color-accent-dark);
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    th,
    td {
      display: block;
      width: auto;
    }

    th {
      border-bottom: none;
      padding-bottom: 8px;
    }

    td {
      padding-top: 0;
    }

    .section-row th {
      display: block;
      border-bottom: 1px solid #e5e7eb;
      padding: 14px 18px;
    }
  }
</style>
